{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "system2_plan": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "const": "skill_graph" },
        "task_name": { "type": "string" },
        "scene_summary": { "type": "string" },
        "subtasks": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/subtask" }
        }
      },
      "required": ["type", "task_name", "scene_summary", "subtasks"],
      "additionalProperties": false
    }
  },
  "required": ["system2_plan"],
  "additionalProperties": false,
  "$defs": {
    "subtask": {
      "type": "object",
      "properties": {
        "subtask_id": { "type": "integer", "minimum": 0 },
        "skill": { "type": "string", "enum": ["pick", "transport", "place", "pour", "open"] },
        "description": { "type": "string" },
        "params": { "type": "object", "additionalProperties": true },
        "formula": { "$ref": "#/$defs/formula" }
      },
      "required": ["subtask_id", "skill", "description", "params", "formula"],
      "additionalProperties": false
    },
    "formula": {
      "oneOf": [
        {
          "type": "object",
          "properties": { "type": { "type": "string", "const": "true" } },
          "required": ["type"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": { "type": "string", "const": "predicate" },
            "name": { "type": "string" },
            "args": { "type": "array", "items": {} }
          },
          "required": ["type", "name", "args"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": { "type": "string", "const": "not" },
            "child": { "$ref": "#/$defs/formula" }
          },
          "required": ["type", "child"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": { "type": "string", "const": "and" },
            "children": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/formula" }
            }
          },
          "required": ["type", "children"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": { "type": "string", "const": "implies" },
            "left": { "$ref": "#/$defs/formula" },
            "right": { "$ref": "#/$defs/formula" }
          },
          "required": ["type", "left", "right"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": { "type": "string", "enum": ["always", "eventually"] },
            "interval": { "$ref": "#/$defs/interval" },
            "child": { "$ref": "#/$defs/formula" }
          },
          "required": ["type", "interval", "child"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": { "type": "string", "const": "until" },
            "interval": { "$ref": "#/$defs/interval" },
            "left": { "$ref": "#/$defs/formula" },
            "right": { "$ref": "#/$defs/formula" }
          },
          "required": ["type", "interval", "left", "right"],
          "additionalProperties": false
        }
      ]
    },
    "interval": {
      "type": ["array", "null"],
      "prefixItems": [
        { "type": "integer", "minimum": 0 },
        { "type": "integer", "minimum": 0 }
      ],
      "minItems": 2,
      "maxItems": 2
    }
  }
}
